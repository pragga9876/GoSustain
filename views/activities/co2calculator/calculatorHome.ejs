<% pageCSS = ["calculatorHome"]; %>

<div class="app-container">

  <header class="header">
    <h2>Home Energy</h2>
  </header>

  <div class="progress-dots">
    <span class="dot"></span>
    <span class="dot active"></span>
    <span class="dot"></span>
    <span class="dot"></span>
  </div>

  <form action="/calculator/home" method="POST">

    <main class="content">

      <br><br>

      <div class="card">
        <img src="/images/calculatorHome.png" alt="House" class="hero-image" />
      </div>

      <br><br>

      <h3>Home Energy Usage</h3>
      <p>Estimate your home's energy consumption to calculate your carbon footprint.</p>

      <div class="section">
        <label>Monthly Electricity Usage (kWh)</label>
        <div class="slider-group">
          <input type="range" min="0" max="1500" value="150"
                 id="electricityRange" name="electricityKwh">
          <span id="electricityValue">150 kWh</span>
        </div>
      </div>

      <div class="section">
        <label>Household Size</label>
        <p class="subtext">Number of people living in your household</p>

        <div class="counter">
          <button type="button" id="decrease">−</button>
          <span id="householdValue">2</span>
          <input type="hidden" name="householdSize" id="householdHidden" value="2">
          <button type="button" id="increase">+</button>
        </div>
      </div>

      <div class="section">
        <label>Energy Source</label>
        <select name="energySource" id="energySource" required>
          <option value="" disabled selected>Select</option>
          <option value="renewable">☀️ Renewable</option>
          <option value="mixed">🔋 Mixed</option>
          <option value="nonrenewable">🛢️ Non-Renewable</option>
        </select>
      </div>

      <div class="section">
        <label>Main Heating Fuel</label>
        <select name="heatingFuel" id="heatingFuel" required>
          <option value="" disabled selected>Select</option>
          <option value="electric">🔌 Electric</option>
          <option value="gas">⛽ Gas</option>
          <option value="wood">🪵 Wood</option>
        </select>
      </div>

      <div class="section">
        <label>Monthly LPG Cylinders</label>
        <div class="slider-group">
          <input type="range" min="0" max="3" step="0.1" value="0"
                 id="lpgRange" name="lpgCylinders">
          <span id="lpgValue">0 cylinders</span>
        </div>
      </div>

      <div class="section">
        <label>Monthly Water Usage (litres)</label>
        <div class="slider-group">
          <input type="range" min="0" max="30000" step="100"
                 value="5000" id="waterRange" name="waterUsage">
          <span id="waterValue">5000 L</span>
        </div>
      </div>

      <input type="hidden" name="homeEstimate" id="homeEstimateHidden" value="0">

      <div class="section">
        <label>Estimated Home CO₂</label>
        <div class="counter">
          <span id="homeEstimatePreview">0.0 kg CO₂ / week</span>
        </div>
      </div>

      <div class="buttons">
        <a href="/calculator/travel"><button type="button" class="prev">Previous</button></a>
        <button type="submit" class="next">Next</button>
      </div>

    </main>
  </form>
</div>

<script>
  const htmlElement = document.documentElement;

  function setTheme(theme) {
    if (theme === 'dark') {
      htmlElement.classList.remove('light');
      htmlElement.classList.add('dark');
    } else {
      htmlElement.classList.remove('dark');
      htmlElement.classList.add('light');
    }
    localStorage.setItem('theme', theme);
  }

  const savedTheme = localStorage.getItem('theme');
  setTheme(savedTheme || 'light');

  function updateSlider(sliderElement, valueElement, suffix = "") {
    const value = Number(sliderElement.value);
    const min = Number(sliderElement.min);
    const max = Number(sliderElement.max);
    const percent = ((value - min) / (max - min)) * 100;

    valueElement.textContent = `${value} ${suffix}`.trim();
    sliderElement.style.setProperty('--value-percent', `${percent}%`);
  }

  const electricityRange = document.getElementById('electricityRange');
  const electricityValue = document.getElementById('electricityValue');

  const lpgRange = document.getElementById('lpgRange');
  const lpgValue = document.getElementById('lpgValue');

  const waterRange = document.getElementById('waterRange');
  const waterValue = document.getElementById('waterValue');

  const energySource = document.getElementById('energySource');
  const heatingFuel = document.getElementById('heatingFuel');

  const decrease = document.getElementById('decrease');
  const increase = document.getElementById('increase');
  const householdValue = document.getElementById('householdValue');
  const householdHidden = document.getElementById('householdHidden');

  const homeEstimatePreview = document.getElementById('homeEstimatePreview');
  const homeEstimateHidden = document.getElementById('homeEstimateHidden');

  let count = 2;

  function getEnergySourceFactor(source) {
    switch (source) {
      case "renewable": return 0.20;
      case "mixed": return 0.45;
      case "nonrenewable": return 0.70;
      default: return 0.45;
    }
  }

  function getHeatingFactor(fuel) {
    switch (fuel) {
      case "electric": return 0.8;
      case "gas": return 2.5;
      case "wood": return 1.2;
      default: return 0;
    }
  }

  function calculateHomeEstimate() {
    const electricityKwh = Number(electricityRange.value || 0);
    const householdSize = Number(householdHidden.value || 1);
    const lpgCylinders = Number(lpgRange.value || 0);
    const waterUsage = Number(waterRange.value || 0);

    const sourceFactor = getEnergySourceFactor(energySource.value);
    const heatingFactor = getHeatingFactor(heatingFuel.value);

    const electricityMonthly = electricityKwh * sourceFactor;
    const lpgMonthly = lpgCylinders * 29.0;
    const waterMonthly = waterUsage * 0.0003;
    const heatingMonthly = householdSize * heatingFactor;

    const monthlyTotal = electricityMonthly + lpgMonthly + waterMonthly + heatingMonthly;
    const weeklyTotal = monthlyTotal / 4.345;

    const rounded = weeklyTotal.toFixed(1);
    homeEstimatePreview.textContent = `${rounded} kg CO₂ / week`;
    homeEstimateHidden.value = rounded;
  }

  electricityRange.addEventListener('input', () => {
    updateSlider(electricityRange, electricityValue, "kWh");
    calculateHomeEstimate();
  });

  lpgRange.addEventListener('input', () => {
    updateSlider(lpgRange, lpgValue, "cylinders");
    calculateHomeEstimate();
  });

  waterRange.addEventListener('input', () => {
    updateSlider(waterRange, waterValue, "L");
    calculateHomeEstimate();
  });

  decrease.addEventListener('click', () => {
    if (count > 1) {
      count--;
      householdValue.textContent = count;
      householdHidden.value = count;
      calculateHomeEstimate();
    }
  });

  increase.addEventListener('click', () => {
    count++;
    householdValue.textContent = count;
    householdHidden.value = count;
    calculateHomeEstimate();
  });

  energySource.addEventListener('change', calculateHomeEstimate);
  heatingFuel.addEventListener('change', calculateHomeEstimate);

  document.addEventListener('DOMContentLoaded', () => {
    updateSlider(electricityRange, electricityValue, "kWh");
    updateSlider(lpgRange, lpgValue, "cylinders");
    updateSlider(waterRange, waterValue, "L");
    calculateHomeEstimate();
  });
</script>
<% pageCSS = ["travel&transportation"]; %>

<div class="app-container">

  <header class="app-header">
    <a href="/calculator/start"><div class="back-arrow">←</div></a>
    <h1>Travel and Transportation</h1>
  </header>

  <div class="progress-dots">
    <span class="dot active"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
  </div>

  <form action="/calculator/travel" method="POST">
    <main class="content">

      <img src="/images/travel&transportation.png" class="hero-image">

      <h2>Travel & Transportation</h2>
      <p>Understand your carbon footprint from daily commutes and long-distance travel.</p>

      <div class="input-section">

        <label>Weekly Driving Distance (km)</label>
        <div class="slider-group">
          <input type="range" min="0" max="500" value="50" id="drivingRange" name="carKm">
          <span id="drivingValue">50 km</span>
        </div>

        <label>Primary Vehicle Type</label>
        <select id="vehicleType" class="select-box" name="vehicleType" required>
          <option value="" disabled selected>Select</option>
          <option value="petrol">⛽ Petrol / Gasoline</option>
          <option value="diesel">🛢️ Diesel</option>
          <option value="hybrid">⚡ Hybrid</option>
          <option value="electric">🔋 Electric</option>
        </select>

        <label>Weekly Bus Distance (km)</label>
        <div class="slider-group">
          <input type="range" min="0" max="300" value="20" id="busRange" name="busKm">
          <span id="busValue">20 km</span>
        </div>

        <label>Weekly Train / Metro Distance (km)</label>
        <div class="slider-group">
          <input type="range" min="0" max="300" value="10" id="trainRange" name="trainKm">
          <span id="trainValue">10 km</span>
        </div>

        <label>Weekly Bike / Scooter Distance (km)</label>
        <div class="slider-group">
          <input type="range" min="0" max="300" value="0" id="bikeRange" name="bikeKm">
          <span id="bikeValue">0 km</span>
        </div>

        <label>Yearly Flight Distance (km)</label>
        <div class="slider-group">
          <input type="range" min="0" max="50000" step="100" value="0" id="flightRange" name="flightKm">
          <span id="flightValue">0 km</span>
        </div>

        <div class="flight-section">
          <label>Typical Flight Distance</label>
          <select id="flightPreset" class="select-box">
            <option value="">Select a quick preset</option>
            <option value="800">Domestic short trip (~800 km)</option>
            <option value="2500">Domestic / regional (~2500 km)</option>
            <option value="7000">International medium-haul (~7000 km)</option>
            <option value="12000">Long-haul (~12000 km)</option>
          </select>
        </div>

        <input type="hidden" name="travelEstimate" id="travelEstimateHidden" value="0">

        <div class="flight-section">
          <label>Estimated Travel CO₂</label>
          <div class="counter">
            <span id="travelEstimatePreview">0.0 kg CO₂ / week</span>
          </div>
        </div>

      </div>

      <button type="submit" class="next-btn">Next</button>

    </main>
  </form>

</div>

<script>
  const htmlElement = document.documentElement;

  function setTheme(theme) {
    if (theme === 'dark') {
      htmlElement.classList.remove('light');
      htmlElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    } else {
      htmlElement.classList.remove('dark');
      htmlElement.classList.add('light');
      localStorage.setItem('theme', 'light');
    }
  }

  const savedTheme = localStorage.getItem('theme');
  setTheme(savedTheme || 'light');

  document.querySelector('.back-arrow').addEventListener('click', () => {
    window.history.back();
  });

  function updateSlider(sliderElement, valueElement, suffix = "") {
    const value = Number(sliderElement.value);
    const min = Number(sliderElement.min || 0);
    const max = Number(sliderElement.max || 100);
    const percent = ((value - min) / (max - min)) * 100;

    valueElement.textContent = `${value} ${suffix}`.trim();
    sliderElement.style.setProperty('--value-percent', `${percent}%`);
  }

  const drivingRange = document.getElementById('drivingRange');
  const drivingValue = document.getElementById('drivingValue');

  const busRange = document.getElementById('busRange');
  const busValue = document.getElementById('busValue');

  const trainRange = document.getElementById('trainRange');
  const trainValue = document.getElementById('trainValue');

  const bikeRange = document.getElementById('bikeRange');
  const bikeValue = document.getElementById('bikeValue');

  const flightRange = document.getElementById('flightRange');
  const flightValue = document.getElementById('flightValue');

  const vehicleType = document.getElementById('vehicleType');
  const flightPreset = document.getElementById('flightPreset');
  const travelEstimatePreview = document.getElementById('travelEstimatePreview');
  const travelEstimateHidden = document.getElementById('travelEstimateHidden');

  function getVehicleFactor(type) {
    switch (type) {
      case "petrol": return 0.192;
      case "diesel": return 0.171;
      case "hybrid": return 0.110;
      case "electric": return 0.060;
      default: return 0.150;
    }
  }

  function calculateTravelEstimate() {
    const carKm = Number(drivingRange.value || 0);
    const busKm = Number(busRange.value || 0);
    const trainKm = Number(trainRange.value || 0);
    const bikeKm = Number(bikeRange.value || 0);
    const flightKmYear = Number(flightRange.value || 0);

    const carFactor = getVehicleFactor(vehicleType.value);
    const busFactor = 0.105;
    const trainFactor = 0.041;
    const bikeFactor = 0.072;
    const flightFactor = 0.146;

    const weeklyFlightKm = flightKmYear / 52;

    const travelCO2 =
      (carKm * carFactor) +
      (busKm * busFactor) +
      (trainKm * trainFactor) +
      (bikeKm * bikeFactor) +
      (weeklyFlightKm * flightFactor);

    const rounded = travelCO2.toFixed(1);
    travelEstimatePreview.textContent = `${rounded} kg CO₂ / week`;
    travelEstimateHidden.value = rounded;
  }

  flightPreset.addEventListener('change', () => {
    if (flightPreset.value) {
      flightRange.value = flightPreset.value;
      updateSlider(flightRange, flightValue, "km");
      calculateTravelEstimate();
    }
  });

  [drivingRange, busRange, trainRange, bikeRange, flightRange].forEach(el => {
    el.addEventListener('input', () => {
      if (el === drivingRange) updateSlider(drivingRange, drivingValue, "km");
      if (el === busRange) updateSlider(busRange, busValue, "km");
      if (el === trainRange) updateSlider(trainRange, trainValue, "km");
      if (el === bikeRange) updateSlider(bikeRange, bikeValue, "km");
      if (el === flightRange) updateSlider(flightRange, flightValue, "km");
      calculateTravelEstimate();
    });
  });

  vehicleType.addEventListener('change', calculateTravelEstimate);

  document.addEventListener('DOMContentLoaded', () => {
    updateSlider(drivingRange, drivingValue, "km");
    updateSlider(busRange, busValue, "km");
    updateSlider(trainRange, trainValue, "km");
    updateSlider(bikeRange, bikeValue, "km");
    updateSlider(flightRange, flightValue, "km");
    calculateTravelEstimate();
  });
</script>
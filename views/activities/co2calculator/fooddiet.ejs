<% pageCSS = ["theme", "food"]; %>

<div class="fooddiet-page">

<div class="app-container">

  <header class="app-header">
    <a href="/calculator/home"><div class="back-arrow">←</div></a>
    <h1>Food and Diet</h1>
  </header>

  <div class="progress-dots">
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot active"></span>
    <span class="dot"></span>
  </div>

  <form action="/calculator/fooddiet" method="POST">

    <main class="content">

      <img src="/images/fooddiet.png" class="hero-image">

      <h2>Food & Diet</h2>
      <p>Tell us about your eating habits to estimate your food-related carbon footprint.</p>

      <div class="input-section">

        <label>Diet Type</label>
        <select name="dietType" id="dietType" class="select-box" required>
          <option value="" disabled selected>Select diet type</option>
          <option value="vegan">Vegan</option>
          <option value="vegetarian">Vegetarian</option>
          <option value="pescatarian">Pescatarian</option>
          <option value="omnivore">Non-Vegetarian</option>
        </select>

        <div id="meatFrequencyWrapper">
          <label>Meat Consumption Frequency</label>
          <select name="meatFrequency" id="meatFrequency" class="select-box" required>
            <option value="" disabled selected>Select frequency</option>
            <option value="daily">Daily</option>
            <option value="weekly">Few times a week</option>
            <option value="occasionally">Occasionally</option>
            <option value="never">Never</option>
          </select>
        </div>

        <label>Local Food Percentage <span id="localValue">50%</span></label>
        <div class="slider-group">
          <input type="range" min="0" max="100" value="50" 
                 id="localRange" name="localFoodPercentage">
        </div>

        <label>Food Waste</label>
        <select name="foodWaste" id="foodWaste" class="select-box" required>
          <option value="" disabled selected>Select level</option>
          <option value="low">Low</option>
          <option value="moderate">Moderate</option>
          <option value="high">High</option>
        </select>

        <input type="hidden" name="foodEstimate" id="foodEstimateHidden" value="0">

        <div class="button-group">
          <div class="counter">
            <span id="foodEstimatePreview">0.0 kg CO₂ / week</span>
          </div>
        </div>

      </div>

      <div class="button-group">
        <a href="/calculator/home">
          <button type="button" class="prev-btn">Previous</button>
        </a>
        <button type="submit" class="next-btn">Next</button>
      </div>

    </main>

  </form>

</div>

</div>

<script>
  document.querySelector('.back-arrow').addEventListener('click', () => {
    window.history.back();
  });

  const localRange = document.getElementById("localRange");
  const localValue = document.getElementById("localValue");
  const dietType = document.getElementById("dietType");
  const meatFrequency = document.getElementById("meatFrequency");
  const meatFrequencyWrapper = document.getElementById("meatFrequencyWrapper");
  const foodWaste = document.getElementById("foodWaste");
  const foodEstimatePreview = document.getElementById("foodEstimatePreview");
  const foodEstimateHidden = document.getElementById("foodEstimateHidden");

  function updateSlider(sliderElement, valueElement) {
    const value = Number(sliderElement.value);
    const min = Number(sliderElement.min || 0);
    const max = Number(sliderElement.max || 100);
    const percent = ((value - min) / (max - min)) * 100;

    valueElement.textContent = value + "%";
    sliderElement.style.setProperty('--value-percent', `${percent}%`);
  }

  function updateDietLogic() {
    const selectedDiet = dietType.value;

    if (selectedDiet === "vegan" || selectedDiet === "vegetarian") {
      meatFrequency.value = "never";
      meatFrequencyWrapper.style.display = "none";
      meatFrequency.required = false;
    } else {
      meatFrequencyWrapper.style.display = "block";
      meatFrequency.required = true;
    }
  }

  function calculateFoodEstimate() {
    const selectedDiet = dietType.value;
    const selectedMeat = meatFrequency.value;
    const localPct = Number(localRange.value || 0);
    const wasteLevel = foodWaste.value;

    let base = 0;

    switch (selectedDiet) {
      case "vegan":
        base = 15;
        break;
      case "vegetarian":
        base = 22;
        break;
      case "pescatarian":
        base = 28;
        break;
      case "omnivore":
        base = 38;
        break;
      default:
        base = 0;
    }

    let meatAdj = 0;
    if (selectedDiet === "omnivore" || selectedDiet === "pescatarian") {
      switch (selectedMeat) {
        case "daily": meatAdj = 10; break;
        case "weekly": meatAdj = 5; break;
        case "occasionally": meatAdj = 2; break;
        case "never": meatAdj = 0; break;
      }
    }

    let localAdj = ((100 - localPct) / 100) * 6;

    let wasteAdj = 0;
    switch (wasteLevel) {
      case "low": wasteAdj = 1; break;
      case "moderate": wasteAdj = 4; break;
      case "high": wasteAdj = 8; break;
    }

    const total = (base + meatAdj + localAdj + wasteAdj);
    const rounded = total.toFixed(1);

    foodEstimatePreview.textContent = `${rounded} kg CO₂ / week`;
    foodEstimateHidden.value = rounded;
  }

  localRange.addEventListener("input", () => {
    updateSlider(localRange, localValue);
    calculateFoodEstimate();
  });

  dietType.addEventListener("change", () => {
    updateDietLogic();
    calculateFoodEstimate();
  });

  meatFrequency.addEventListener("change", calculateFoodEstimate);
  foodWaste.addEventListener("change", calculateFoodEstimate);

  document.addEventListener('DOMContentLoaded', () => {
    updateSlider(localRange, localValue);
    updateDietLogic();
    calculateFoodEstimate();
  });
</script>

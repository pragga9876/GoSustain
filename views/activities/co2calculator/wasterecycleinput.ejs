<% pageCSS = ["theme", "wasterecycleinput"]; %>

<form id="wasteForm" action="/calculator/wasterecycle" method="POST">
<div class="design-root">

    <div class="main-content">

        <header class="header">
            <div class="icon-wrapper"></div>
            <h2 class="header-title">Waste and Recycling</h2>
        </header>

        <div class="progress-dots">
            <div class="dot"></div>
            <div class="dot"></div>
            <div class="dot"></div>
            <div class="dot active"></div>
        </div>

        <div class="image-container-wrapper">
            <div class="image-container">
                <div class="hero-image"
                    style='background-image: url("/images/wasterecycleimg.png");'>
                </div>
            </div>
        </div>

        <br>

        <p class="page-description">
            Tell us about your waste and recycling habits.
        </p>

        <div class="slider-container-wrapper">
            <div class="slider-container">
                <div class="slider-labels">
                    <p class="slider-label">Weekly Waste Production (kg)</p>
                </div>

                <div class="slider-track-container">
                    <input type="range" min="0" max="100" step="1" value="32" id="wasteRange" style="width:100%;">
                    <div class="slider-value-desktop" id="wasteValue">32 kg</div>
                </div>
            </div>
        </div>

        <input type="hidden" id="wasteKgInput" name="weeklyWasteKg" value="32">

        <div class="toggle-item">
            <p class="toggle-label">Do you recycle regularly?</p>
            <div class="toggle-switch-container">
                <label class="toggle-switch">
                    <input type="checkbox" id="recycleToggle" class="toggle-checkbox">
                    <div class="toggle-handle"></div>
                </label>
            </div>
        </div>

        <input type="hidden" id="recycleInput" name="recycle" value="false">

        <div class="toggle-item">
            <p class="toggle-label">Do you compost food waste?</p>
            <div class="toggle-switch-container">
                <label class="toggle-switch">
                    <input type="checkbox" id="compostToggle" class="toggle-checkbox">
                    <div class="toggle-handle"></div>
                </label>
            </div>
        </div>

        <input type="hidden" id="compostInput" name="compost" value="false">
        <input type="hidden" id="wasteEstimateHidden" name="wasteEstimate" value="0">

        <div class="toggle-item">
            <p class="toggle-label">Estimated Waste CO₂</p>
            <div class="toggle-switch-container">
                <span id="wasteEstimatePreview">0.0 kg CO₂ / week</span>
            </div>
        </div>

    </div>

    <footer class="footer">
        <div class="footer-content">
            <div class="button-group">

                <a href="/calculator/fooddiet">
                    <button type="button" class="button button-previous">
                        <span>Previous</span>
                    </button>
                </a>

                <button type="submit" class="button button-next">
                    <span>View Results</span>
                </button>

            </div>
        </div>
        <div class="footer-spacer"></div>
    </footer>

</div>
</form>

<script src="/js/theme.js"></script>
<script>
  const wasteRange = document.getElementById("wasteRange");
  const wasteValue = document.getElementById("wasteValue");
  const wasteKgInput = document.getElementById("wasteKgInput");

  const recycleToggle = document.getElementById("recycleToggle");
  const recycleInput = document.getElementById("recycleInput");

  const compostToggle = document.getElementById("compostToggle");
  const compostInput = document.getElementById("compostInput");

  const wasteEstimatePreview = document.getElementById("wasteEstimatePreview");
  const wasteEstimateHidden = document.getElementById("wasteEstimateHidden");

  function calculateWasteEstimate() {
    const weeklyWasteKg = Number(wasteRange.value || 0);
    const recycle = recycleToggle.checked;
    const compost = compostToggle.checked;

    let total = weeklyWasteKg * 0.55;

    if (recycle) total *= 0.82;
    if (compost) total *= 0.88;

    const rounded = total.toFixed(1);
    wasteEstimatePreview.textContent = `${rounded} kg CO₂ / week`;
    wasteEstimateHidden.value = rounded;
  }

  wasteRange.addEventListener("input", () => {
    wasteValue.textContent = `${wasteRange.value} kg`;
    wasteKgInput.value = wasteRange.value;
    calculateWasteEstimate();
  });

  recycleToggle.addEventListener("change", () => {
    recycleInput.value = recycleToggle.checked ? "true" : "false";
    calculateWasteEstimate();
  });

  compostToggle.addEventListener("change", () => {
    compostInput.value = compostToggle.checked ? "true" : "false";
    calculateWasteEstimate();
  });

  document.addEventListener("DOMContentLoaded", () => {
    wasteValue.textContent = `${wasteRange.value} kg`;
    wasteKgInput.value = wasteRange.value;
    recycleInput.value = recycleToggle.checked ? "true" : "false";
    compostInput.value = compostToggle.checked ? "true" : "false";
    calculateWasteEstimate();
  });
</script>

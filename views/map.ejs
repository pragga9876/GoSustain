<% pageCSS = ["map"]; %>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<header class="header">
  <div class="header-left">
    <div class="logo">🌱</div>
    <h1>GREEN LANE</h1>
  </div>

  <div class="header-right">
    <button class="theme-toggle" onclick="toggleTheme()">
      <span id="theme-icon">🌙 Dark</span>
    </button>
  </div>
</header>

<div class="main-container">
  <aside class="sidebar">
    <div class="location-input-container">
      <h2 class="input-header">🗺️ PLAN YOUR ROUTE</h2>

      <div class="location-box">
        <h3 class="location-title">📍 FROM</h3>
        <input
          type="text"
          id="from-input"
          class="location-input"
          placeholder="Enter starting location"
          autocomplete="off"
        />
      </div>

      <div class="location-box">
        <h3 class="location-title">🎯 TO</h3>
        <input
          type="text"
          id="to-input"
          class="location-input"
          placeholder="Enter destination"
          autocomplete="off"
        />
      </div>

      <div class="controls-grid">
        <div class="control-box">
          <label class="mini-label">Travel Mode</label>
          <select class="mode-select" id="mode-select">
            <option value="driving">🚗 Driving</option>
            <option value="walking">🚶 Walking</option>
            <option value="cycling">🚴 Cycling</option>
            <option value="transit">🚌 Public Transit</option>
          </select>
        </div>

        <div class="control-box">
          <label class="mini-label">Refresh</label>
          <select class="mode-select" id="refresh-interval">
            <option value="0">Manual Only</option>
            <option value="15">Every 15 sec</option>
            <option value="30" selected>Every 30 sec</option>
            <option value="60">Every 60 sec</option>
          </select>
        </div>
      </div>
    </div>

    <button class="plan-button" onclick="planRoute()">🚀 FIND BEST ROUTES</button>

    <div class="quick-suggestions">
      <h3 class="suggestions-title">✨ Quick Fill</h3>

      <div class="suggestion-buttons">
        <button class="suggestion-btn" onclick="useCurrentLocation()">📍 My Location</button>
        <button class="suggestion-btn" onclick="showPopularPlaces()">⭐ Popular Places</button>
      </div>

      <div id="popular-places" class="popular-list" style="display: none;">
        <button class="place-btn" onclick="fillDestination('Victoria Memorial, Kolkata')">🏛️ Victoria Memorial</button>
        <button class="place-btn" onclick="fillDestination('Howrah Bridge, Kolkata')">🌉 Howrah Bridge</button>
        <button class="place-btn" onclick="fillDestination('Park Street, Kolkata')">🍽️ Park Street</button>
        <button class="place-btn" onclick="fillDestination('New Market, Kolkata')">🛍️ New Market</button>
      </div>
    </div>

    <div class="live-strip">
      <div class="live-dot"></div>
      <span id="live-status">Ready for live eco-routing</span>
    </div>

    <div class="loading" id="loading">
      <div class="spinner"></div>
      <p style="margin-top: 0.5rem;">Calculating live routes...</p>
    </div>

    <div class="summary-panel" id="summary-panel">
      <h3 class="section-title">📊 Route Summary</h3>
      <div class="summary-grid">
        <div class="summary-card">
          <div class="summary-label">Best Route</div>
          <div class="summary-value" id="best-route-label">—</div>
        </div>
        <div class="summary-card">
          <div class="summary-label">Saved CO₂</div>
          <div class="summary-value" id="saved-co2">—</div>
        </div>
        <div class="summary-card">
          <div class="summary-label">Saved Time</div>
          <div class="summary-value" id="saved-time">—</div>
        </div>
        <div class="summary-card">
          <div class="summary-label">Eco Score</div>
          <div class="summary-value" id="top-eco-score">—</div>
        </div>
      </div>
    </div>

    <div class="ai-insight-panel" id="ai-insight-panel">
      <h3 class="section-title">🤖 Gemini Insight</h3>
      <div class="ai-insight-content" id="ai-insight-content">
        Plan a route to get an AI-generated sustainability recommendation.
      </div>
    </div>

    <div class="routes-container" id="routes-container"></div>
  </aside>

  <div class="map-container">
    <div id="map"></div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/mapScript.js"></script>
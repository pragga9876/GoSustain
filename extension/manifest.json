{
  "manifest_version": 3,
  "name": "GoSustain Purchase Tracker",
  "version": "1.0.0",
  "description": "Extract Amazon and Flipkart purchase/product data and send it to GoSustain backend.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.flipkart.com/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*",
        "https://www.flipkart.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GoSustain Tracker"
  }
}